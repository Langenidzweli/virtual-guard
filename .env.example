DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-strong-local-password
DB_NAME=virtualguard
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
INTERNAL_API_KEY=replace-with-a-long-random-service-key
SPRING_BOOT_URL=http://localhost:8090
BOOTSTRAP_USERS_ENABLED=false
BOOTSTRAP_PASSWORD=replace-with-a-strong-demo-password
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
VISION_MODEL=v2
VISION_ANALYSIS_FPS=5
POSE_ENABLED=true
POSE_MODEL_PATH=models/yolov8n-pose.pt
AI_CONNECT_TIMEOUT_SECONDS=5
AI_READ_TIMEOUT_SECONDS=600
JPA_SHOW_SQL=false
APP_LOG_LEVEL=INFO
# Optional full-stack Docker overrides (see docs/SETUP.md)
# FRONTEND_PORT=8080
# BACKEND_PORT=8090
# AI_PORT=8000
# POSTGRES_PORT=5432
# DOCKER_API_BASE_URL=http://localhost:8090
# DOCKER_CORS_ALLOWED_ORIGINS=http://localhost:8080
# MAX_CONCURRENT_ANALYSES=1

# Used only by ADMIN guard resets; 12+ characters, maximum 72 UTF-8 bytes.
GUARD_TEMPORARY_PASSWORD=
